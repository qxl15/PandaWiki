# ===== 基础服务配置 =====
APP_NAME=TD-OA Attendance Secure Server
HOST=127.0.0.1
PORT=8848
DATABASE_URL=sqlite:///./attendance.db

# ===== 客户端访问安全 =====
JWT_SECRET=PLEASE_CHANGE_TO_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALLOWED_CLIENT_IPS=127.0.0.1,192.168.1.20
TRANSPORT_AES_KEY=PLEASE_CHANGE_TO_32_BYTES_KEY_1234567890

# ===== 通达OA（V12.9）接口配置：只填在服务端 =====
TD_OA_BASE_URL=http://127.0.0.1:8080

# 方案A（可选）：开放平台应用
TD_OA_APP_ID=
TD_OA_APP_SECRET=

# 方案B（V12.9截图对应）：接口管理 -> 接口用户信息（推荐先配这个）
TD_OA_API_USERNAME=请填写接口用户名
TD_OA_API_PASSWORD=请填写接口密码

# V12.9接口路径（按你OA实际接口文档修正）
TD_OA_TOKEN_ENDPOINT=/api/open/token
TD_OA_USERS_ENDPOINT=/api/open/users
TD_OA_GROUPS_ENDPOINT=/api/open/attendance/groups
TD_OA_RECORDS_ENDPOINT=/api/open/attendance/records

# 注意：本工具按只读模式对接OA，除 token 外不允许非GET请求
